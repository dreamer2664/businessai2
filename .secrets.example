# Copy to .secrets/env and fill in. Never commit this file's copy.
GH_OWNER=your-github-username
GH_REPO=businessai2
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OWNER_USERNAME=

# --- real customer channels (milestone 10, optional) — see docs/CHANNELS.md ---
# shop e-mail: any provider; Gmail/Outlook/Yahoo/iCloud need an "app password"
# MAIL_USER=support@yourshop.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_IMAP_HOST=imap.gmail.com
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_FROM_NAME=Your Shop
# Facebook Page messages + Instagram DMs (Meta Graph API, long-lived Page token)
# META_PAGE_ID=1234567890
# META_PAGE_TOKEN=EAAB...
# META_IG_ID=17841400000000000

# --- the agent's OWN accounts (phase 2) ---
# BAI_ACCOUNT_EMAIL=bot@example.com                 # the address I give to sites (or the mailbox below); codes are read over plain IMAP
# BAI_MAIL_PASSWORD=xxxx xxxx xxxx xxxx              # IMAP password for that mailbox — for Gmail an APP PASSWORD (never the account password); set with scripts/set_mail.sh
# BAI_MAIL_IMAP_HOST=imap.gmail.com                  # optional: guessed from the address
# BAI_MAIL_ALIAS=                                    # optional: an alias sites get (only mail TO it is read)
# BAI_ACCOUNT_PASSWORD=...                        # the password it uses for sign-ups (never logged)
# Google Drive/Gmail: put the OAuth "Desktop app" client JSON at .secrets/google_client.json and run:
#   python3 -m agent.google connect      (or say "connect google" to the bot)

# Fallback contact (marathon item 1): your personal addresses + a 2nd bot from @BotFather
# OWNER_EMAILS=you@gmail.com
# FALLBACK_BOT_TOKEN=123456:ABCDEF
